{
  "name": "fitora-root",
  "version": "1.0.0",
  "private": true,
  "description": "Fitora - AI-Powered Realtime Fitness Planner Platform",
  "scripts": {
    "dev": "concurrently -n \"CLIENT,SERVER\" -c \"cyan,magenta\" \"pnpm --filter client dev\" \"pnpm --filter fitora-server dev\"",
    "dev:client": "pnpm --filter client dev",
    "dev:server": "pnpm --filter fitora-server dev",
    "build:client": "pnpm --filter client build",
    "build:server": "pnpm --filter fitora-server build",
    "build": "pnpm build:client && pnpm build:server"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "bcryptjs": "^3.0.3"
  }
}
